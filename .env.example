# Server Configuration
PORT=3001
NODE_ENV=development

# Demo Mode (Set to 'true' to use mock data without external APIs)
DEMO_MODE=true

# Google Places API (New)
GOOGLE_API_KEY=your_google_api_key_here

# SerpApi Key (For secondary web search Website Verification)
SERPAPI_KEY=your_serpapi_key_here

# Groq API (For Lead Analysis and Feature Suggestions)
GROQ_API_KEY_1=
GROQ_API_KEY_2=

# Supabase Configuration
SUPABASE_URL=https://tfgbxjgjpeqlcezfngac.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Frontend `.env` variables (place in frontend/.env)
# VITE_API_BASE_URL=https://your-backend-api.onrender.com/api
# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
