# LeadHunter Production Backend Configuration
# Do NOT check actual .env into version control!

PORT=3001
NODE_ENV=production

# Feature Flags
DEMO_MODE=false

# Google Places API
GOOGLE_API_KEY=your_google_api_key_here

# SerpApi Key
SERPAPI_KEY=your_serpapi_key_here

# Groq API Keys (used for analysis and outreach generation)
GROQ_API_KEY_1=your_groq_key_1_here
GROQ_API_KEY_2=your_groq_key_2_here

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
